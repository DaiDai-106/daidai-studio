{
  "name": "daidai-pi",
  "productName": "Dai",
  "desktopName": "daidai-pi.desktop",
  "version": "0.1.14",
  "private": true,
  "description": "Local AI desktop workbench",
  "author": "Dai contributors",
  "homepage": "https://gitlab.roboticplus.com/dairobot/daidai_agent/daidai_pi",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "npm run build:icons && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:icons": "node --experimental-strip-types scripts/icons.ts",
    "build:native": "node --experimental-strip-types scripts/native.ts",
    "build:cad": "node --experimental-strip-types scripts/native.ts",
    "test:cad": "npm run build && node --experimental-strip-types scripts/native.ts --test",
    "build": "npm run typecheck && npm run build:icons && electron-vite build",
    "test": "npm run build && node -e \"require('electron')\" && node --experimental-strip-types --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm test",
    "package:dir": "npm run build && node --experimental-strip-types electron.package.ts",
    "package:deb": "npm run build && node --experimental-strip-types electron.package.ts --deb",
    "package:mac": "npm run build && node --experimental-strip-types electron.package.ts --mac",
    "package:win": "npm run build && node --experimental-strip-types electron.package.ts --win",
    "package": "npm run package:dir"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@swc/core": "1.16.20",
    "@types/debug": "4.1.13",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.0",
    "lucide-react": "1.61.0",
    "playwright": "1.64.1",
    "png2icons": "2.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
