{
  "name": "dai-studio",
  "productName": "Dai Studio",
  "desktopName": "dai-studio.desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Local AI desktop workbench",
  "author": "Dai contributors",
  "homepage": "https://gitlab.roboticplus.com/dairobot/daidai_agent/daidai_pi",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "npm run build:icons && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:icons": "node --experimental-strip-types scripts/icons.ts",
    "build:scene": "cmake -S modules/scene/cmake -B modules/scene/build/bootstrap && cmake --build modules/scene/build/bootstrap --config Release",
    "build:planning": "cmake -S modules/planning -B modules/planning/build -DCMAKE_BUILD_TYPE=Release && cmake --build modules/planning/build --config Release && cmake --install modules/planning/build --config Release --prefix modules/planning/runtime",
    "build:package": "npm run build:scene && npm run build",
    "build": "npm run typecheck && npm run build:icons && electron-vite build",
    "test": "npm run build && node -e \"require('electron')\" && node tests/runners/test_runner.mjs",
    "check": "npm run lint && npm test",
    "package:dir": "npm run build:package && node --experimental-strip-types electron.package.ts",
    "package:deb": "npm run build:package && node --experimental-strip-types electron.package.ts --deb",
    "package:win": "npm run build:package && node --experimental-strip-types electron.package.ts --win"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-mcp": "1.6.0",
    "@xmldom/xmldom": "0.9.12",
    "shiki": "4.6.0",
    "typebox": "1.3.27",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.17",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "playwright": "1.64.1",
    "png2icons": "2.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
