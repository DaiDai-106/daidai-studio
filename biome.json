{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.css",
      "**/*.html",
      "**/*.json",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  }
}
