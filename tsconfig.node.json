{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "electron"]
  },
  "include": [
    "package.json",
    "electron.vite.config.ts",
    "electron.package.ts",
    "scripts/**/*.ts",
    "src/desktop/**/*.ts",
    "src/backend/**/*.ts",
    "src/contracts/**/*.ts",
    "src/renderer/env.d.ts",
    "src/renderer/**/*.ts",
    "tests/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
