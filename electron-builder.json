{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "local.dai-studio",
  "directories": {
    "output": "release",
    "buildResources": "dist/icons"
  },
  "files": ["dist/**", "package.json", "!dist/icons/*.icns"],
  "extraResources": [
    {
      "from": "modules/scene/runtime",
      "to": "modules/scene/runtime",
      "filter": ["licenses/**"]
    }
  ],
  "publish": null,
  "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
  "mac": {
    "target": ["dmg"],
    "icon": "dist/icons/app.icns",
    "category": "public.app-category.productivity",
    "type": "distribution",
    "forceCodeSigning": true,
    "hardenedRuntime": true,
    "notarize": false,
    "extraFiles": [
      { "from": "modules/scene/runtime/cad-import", "to": "MacOS/cad-import" },
      { "from": "modules/scene/runtime/lib", "to": "Frameworks", "filter": ["*.dylib"] }
    ]
  },
  "dmg": {
    "title": "${productName} ${version}",
    "icon": "dist/icons/app.icns",
    "backgroundColor": "#F4F1EA",
    "sign": true,
    "writeUpdateInfo": false,
    "contents": [
      {
        "x": 160,
        "y": 180,
        "type": "file"
      },
      {
        "x": 380,
        "y": 180,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "target": ["nsis"],
    "icon": "dist/icons/app.ico",
    "signExecutable": false,
    "extraResources": [
      {
        "from": "modules/scene/runtime",
        "to": "modules/scene/runtime",
        "filter": ["cad-import.exe", "*.dll"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${name}-setup-${version}-${arch}.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["deb"],
    "icon": "dist/icons",
    "category": "Utility",
    "syncDesktopName": true,
    "extraResources": [
      {
        "from": "modules/scene/runtime",
        "to": "modules/scene/runtime",
        "filter": ["cad-import", "lib/**"]
      }
    ]
  },
  "deb": {
    "artifactName": "${name}_${version}_${arch}.${ext}",
    "maintainer": "Dai contributors",
    "recommends": ["hicolor-icon-theme"],
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libssl3t64",
      "libstdc++6"
    ]
  }
}
